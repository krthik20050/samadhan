# ---------------------------------------------------------------------------
# REQUIRED FOR MVP (app starts without the OPTIONAL section)
# ---------------------------------------------------------------------------

# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grievance_mvp
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Supabase (REQUIRED for hosted DB/storage; local dev can use DATABASE_URL)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (public, safe to expose)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# OPTIONAL / FUTURE (leave blank; app must start without these)
# ---------------------------------------------------------------------------

# Voice / STT
SARVAM_API_KEY=

# LLM structured extraction
LLM_API_KEY=
LLM_MODEL=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
