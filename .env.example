# ---------------------------------------------------------------------------
# NAMES ONLY — the values live in Infisical, never on disk.
#
# Project: `samadhan` · environment: `dev` on your machine (`staging`/`prod` for
# the hosted runtimes). One-time setup: docs/INFISICAL.md.
#
# Start the app through the CLI so these names arrive as environment variables:
#
#   cd backend
#   infisical run --env=dev -- py -m uvicorn app.main:app --reload --port 8000
#
# pydantic-settings and Vite both give real environment variables priority over
# any .env file, so the app code is unchanged and no .env needs to exist. Keep
# this file as the canonical list of names: it is the file you drag onto
# Infisical's Secrets Overview page, and the checklist for new team members.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# REQUIRED FOR MVP (app starts without the OPTIONAL section)
# ---------------------------------------------------------------------------

# Backend (FastAPI reads these through app/core/config.py)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grievance_mvp
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Staff shared secret for operational endpoints (dashboard list, status
# writes). REQUIRED in any deployed env — endpoints fail closed without it.
# Generate: py -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Supabase (REQUIRED for hosted DB/storage; local dev can use DATABASE_URL).
# The Edge Function is handed SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY by the
# platform itself, so these only need values for local FastAPI runs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (user authentication on the website — Google / email code sign-in).
# Read by the Edge Function; FastAPI does not need them.
# CLERK_ISSUER: your Clerk instance origin, e.g. https://honest-shepherd-12.clerk.accounts.dev
# CLERK_SECRET_KEY: sk_test_... / sk_live_... (Backend API: profile lookup + admin role)
CLERK_ISSUER=
CLERK_SECRET_KEY=

# Frontend (public, safe to expose)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# OPTIONAL / FUTURE (leave blank; app must start without these)
# ---------------------------------------------------------------------------

# Voice / STT
SARVAM_API_KEY=

# LLM structured extraction (Groq vision reads ticket photos in the Edge
# Function; LLM_* is the FastAPI-side placeholder)
LLM_API_KEY=
LLM_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# WhatsApp Cloud API (app ID/secret live in Meta's dashboard; these four are
# what the webhook handler reads — APP_SECRET verifies the webhook signature
# and MUST be set in any deployed environment; the handler fails closed).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
# Optional locally; recommended when webhook is public (sent as setWebhook secret_token)
TELEGRAM_SECRET_TOKEN=

# Edge Function only (set via `supabase secrets set`, not Infisical):
# Allowed browser origin for CORS (AUDIT.md H-1). e.g. https://samadhan.vercel.app
# Leave unset in local dev only — deployed environments must pin it.
SITE_URL=
