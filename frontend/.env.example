[TEMPLATE]
# Names only. Values live in Infisical (Development) on your machine and in
# Vercel's env settings for the deployed build - see docs/INFISICAL.md.
# Only VITE_* vars belong here: they are inlined into the browser bundle at
# build time, so never put a server key in this file.
#
# `npm run dev` runs `infisical run --env=dev -- vite`, which injects these
# names from Infisical; a leftover .env.local no longer wins, because Vite
# never overwrites variables that already exist in the environment.
# `npm run dev:local` starts Vite without the CLI.

# Local dev: FastAPI on :8000. Hosted: Supabase Edge Function
# (https://<project-ref>.supabase.co/functions/v1/api) - see supabase/README.md.
# Override with http://localhost:8000 for local FastAPI development.
VITE_API_URL=
# Clerk publishable key (passenger sign-in with Google / email code)
# e.g. pk_test_a2V5Li4u or pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=
